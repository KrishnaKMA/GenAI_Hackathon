    [c for c in df.columns if c.startswith("V") and pd.api.types.is_numeric_dtype(df[c])][:50] +
    ["TransactionAmt"]
)
tx_num_cols = list(dict.fromkeys(tx_num_cols))  # deduplicate

# encode M-features at transaction level
m_cols_raw = [c for c in df.columns if c.startswith("M")]
df_tx = df[tx_num_cols + ["card1", "isFraud"]].copy()
for col in m_cols_raw:
    if col in df.columns:
        df_tx[col] = df[col].map({"T": 1, "F": 0}).fillna(-1)

# join GNN embeddings from card_feats to transaction level
emb_cols = [c for c in card_feats.columns if c.startswith("gnn_emb_")]
if emb_cols:
    card_emb = card_feats[["card1"] + emb_cols]
    df_tx    = df_tx.merge(card_emb, on="card1", how="left")
    df_tx[emb_cols] = df_tx[emb_cols].fillna(0)
    print(f"  Joined {len(emb_cols)} GNN embedding features to transactions")
else:
    emb_cols = []

lgbm_tx_features = tx_num_cols + m_cols_raw + emb_cols
lgbm_tx_features = [c for c in lgbm_tx_features if c in df_tx.columns]
print(f"  Total LightGBM features: {len(lgbm_tx_features)}")

X_tx = df_tx[lgbm_tx_features].fillna(-999).values.astype(np.float32)
y_tx = df_tx["isFraud"].values

# stratified split at transaction level
from sklearn.model_selection import train_test_split as tts
X_tr, X_te, y_tr, y_te, idx_tr, idx_te = tts(
    X_tx, y_tx, np.arange(len(y_tx)),
    test_size=0.2, stratify=y_tx, random_state=SEED
)

fraud = y_tr.sum()
clean = len(y_tr) - fraud
scale = (clean / fraud) * 2.0
print(f"  Transactions — train: {len(y_tr):,}  test: {len(y_te):,}")
print(f"  Fraud rate: {y_tr.mean():.2%}  |  scale: {scale:.1f}")

# 5-fold OOF for threshold calibration
oof_probs_tx = np.zeros(len(y_tr))
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)

for fold, (tr_idx, val_idx) in enumerate(skf.split(X_tr, y_tr)):
    fold_model = lgb.LGBMClassifier(
        n_estimators=2000, learning_rate=0.01, max_depth=7,
        num_leaves=63, min_child_samples=20, subsample=0.8,
        colsample_bytree=0.8, scale_pos_weight=scale,
        random_state=SEED, n_jobs=-1, verbose=-1,
    )
    fold_model.fit(
        X_tr[tr_idx], y_tr[tr_idx],
        eval_set=[(X_tr[val_idx], y_tr[val_idx])],
        callbacks=[lgb.early_stopping(50, verbose=False)],
    )
    oof_probs_tx[val_idx] = fold_model.predict_proba(X_tr[val_idx])[:, 1]
    print(f"  Fold {fold+1} done")

# train final model on all training transactions
lgbm_model = lgb.LGBMClassifier(
    n_estimators=2000, learning_rate=0.01, max_depth=7,
    num_leaves=63, min_child_samples=20, subsample=0.8,
    colsample_bytree=0.8, scale_pos_weight=scale,
    random_state=SEED, n_jobs=-1, verbose=-1,
)
lgbm_model.fit(X_tr, y_tr)

# ── aggregate transaction probs to card level ─────────────────────────────────
print("\nAggregating transaction predictions to card level …")
all_probs_tx       = lgbm_model.predict_proba(X_tx)[:, 1]
df_tx["lgbm_prob"] = all_probs_tx

card_lgbm = df_tx.groupby("card1").agg(
    lgbm_max_prob  = ("lgbm_prob", "max"),
    lgbm_mean_prob = ("lgbm_prob", "mean"),
    lgbm_top3_prob = ("lgbm_prob", lambda x: x.nlargest(3).mean()),
).reset_index()

card_lgbm = card_lgbm.merge(card_feats[["card1", "label"]], on="card1", how="left")
y_card    = card_lgbm["label"].values

# find best card-level threshold using max_prob
precisions, recalls, thresholds = precision_recall_curve(y_card, card_lgbm["lgbm_max_prob"])
f1s = 2 * precisions * recalls / (precisions + recalls + 1e-8)
best_lgbm_thresh = thresholds[f1s[:-1].argmax()]

# evaluate on test cards
test_cards     = set(df_tx.iloc[idx_te]["card1"].unique())
test_card_mask = card_lgbm["card1"].isin(test_cards)
y_card_te      = card_lgbm.loc[test_card_mask, "label"].values
probs_card_te  = card_lgbm.loc[test_card_mask, "lgbm_max_prob"].values

lgbm_auc    = roc_auc_score(y_card_te, probs_card_te)
lgbm_preds  = (probs_card_te > best_lgbm_thresh).astype(int)
lgbm_prec   = precision_score(y_card_te, lgbm_preds, zero_division=0)
lgbm_recall = recall_score(y_card_te, lgbm_preds, zero_division=0)
lgbm_f1     = f1_score(y_card_te, lgbm_preds, zero_division=0)

print(f"  LightGBM AUC       : {lgbm_auc:.4f}")
print(f"  LightGBM precision : {lgbm_prec:.4f}  (target > 0.65)")
print(f"  LightGBM recall    : {lgbm_recall:.4f}")
print(f"  LightGBM F1        : {lgbm_f1:.4f}  (target > 0.72)")
print(f"  Threshold          : {best_lgbm_thresh:.4f}")

# store card-level probs for ensemble
lgbm_all = card_feats["card1"].map(
    card_lgbm.set_index("card1")["lgbm_max_prob"]
).fillna(0).values

with open(IFOREST_PATH, "wb") as fh:
    pickle.dump({
        "model":        lgbm_model,
        "feature_cols": lgbm_tx_features,
        "threshold":    best_lgbm_thresh,
        "aggregation":  "max",
    }, fh)
print(f"  Saved → {IFOREST_PATH}")


# ── Cell 11c: Remove lgbm_fraud_prob from GNN features ───────────────────────
if "lgbm_fraud_prob" in NODE_FEATURE_COLS:
    NODE_FEATURE_COLS.remove("lgbm_fraud_prob")
    print(f"Removed lgbm_fraud_prob — GNN features: {len(NODE_FEATURE_COLS)}")
else:
    print(f"lgbm_fraud_prob not present — features: {len(NODE_FEATURE_COLS)}")


# ── Cell 11b: Rebuild graph with full feature set ─────────────────────────────
print("Rebuilding graph with full feature set …")

# check for NaNs before scaling
nan_cols = [c for c in NODE_FEATURE_COLS if card_feats[c].isna().any()]
if nan_cols:
    print(f"  Filling NaNs in {len(nan_cols)} columns: {nan_cols[:5]} …")
    card_feats[NODE_FEATURE_COLS] = card_feats[NODE_FEATURE_COLS].fillna(-999)

X_raw    = card_feats[NODE_FEATURE_COLS].values.astype(np.float32)

# catch any remaining NaNs after fillna
assert not np.isnan(X_raw).any(), "NaNs still present after fillna — check feature engineering"

X_scaled = scaler.fit_transform(X_raw)
x        = torch.tensor(X_scaled, dtype=torch.float)
y        = torch.tensor(card_feats["label"].values, dtype=torch.float)
data.x   = x.to(DEVICE)
data.y   = y.to(DEVICE)
print(f"  Features: {data.num_features}  |  Nodes: {data.num_nodes:,}")


# Cell 12: Summary
print("\n" + "="*60)
print("TRAINING COMPLETE")
print("="*60)
print(f"  GNN weights    : {GNN_WEIGHTS}")
print(f"  LightGBM model : {IFOREST_PATH}")
print(f"  GNN AUC-ROC    : {gnn_auc:.4f}")
print(f"  LGBM AUC-ROC   : {lgbm_auc:.4f}")
print(f"  Ensemble AUC   : {test_auc:.4f}  (target > 0.87)")
print(f"  Ensemble F1    : {test_f1:.4f}  (target > 0.72)")
print(f"  Ensemble Prec  : {test_prec:.4f}")
print(f"  LGBM precision : {lgbm_prec:.4f}  (target > 0.65)")
targets_hit = (test_auc > 0.87) and (test_f1 > 0.72) and (lgbm_prec > 0.65)
print(f"  All targets hit: {'YES' if targets_hit else 'NOT YET'}")
print("="*60)


# Cell 13: Inference helper
def predict_card(card_id: int, threshold: float = 0.5) -> dict:
    """
    Return fraud probability + anomaly flag for a card ID.
    (Works after training; load checkpoint + model first.)
    """
    if card_id not in card2idx:
        return {"error": "card_id not seen during training"}
 
    node_idx = card2idx[card_id]
    model.eval()
    with torch.no_grad():
        logit = model(data.x, data.edge_index)[node_idx]
        prob  = torch.sigmoid(logit).item()
 
    row      = df[df["card1"] == card_id][avail_cols].fillna(-999).head(1).values
    if_score = iforest.decision_function(row)[0]
    anomaly  = iforest.predict(row)[0] == -1
 
    return {
        "card_id":          card_id,
        "gnn_fraud_prob":   round(prob, 4),
        "gnn_flag":         prob > threshold,
        "iforest_score":    round(float(if_score), 4),
        "iforest_anomaly":  bool(anomaly),
        "combined_flag":    (prob > threshold) or anomaly,
    }


