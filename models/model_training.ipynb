# Cell 9: Training loop
EPOCHS      = 300
EARLY_STOP  = 40    
best_val_auc = 0.0
no_improve   = 0
print(f"\nTraining for up to {EPOCHS} epochs (early stop = {EARLY_STOP}) …")
t0 = time.time()

for epoch in range(1, EPOCHS + 1):
    # --- train ---
    model.train()
    total_loss = 0
    for batch in train_loader:
        batch = batch.to(DEVICE)
        optimizer.zero_grad()
        out  = model(batch.x, batch.edge_index)
        out  = out[:batch.batch_size]
        y    = batch.y[:batch.batch_size]
        loss = criterion(out, y)
        loss.backward()
        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
        optimizer.step()
        total_loss += loss.item()

    # --- validate ---
    model.eval()
    all_probs, all_y = [], []
    with torch.no_grad():
        for batch in val_loader:
            batch = batch.to(DEVICE)
            out   = model(batch.x, batch.edge_index)
            probs = torch.sigmoid(out[:batch.batch_size]).cpu()
            all_probs.append(probs)
            all_y.append(batch.y[:batch.batch_size].cpu())

    all_probs = torch.cat(all_probs).numpy()
    all_y     = torch.cat(all_y).numpy()
    val_auc   = roc_auc_score(all_y, all_probs)
    val_f1    = f1_score(all_y, (all_probs > 0.5).astype(int), zero_division=0)

    scheduler.step(val_auc)
    history["train_loss"].append(total_loss / len(train_loader))
    history["val_auc"].append(val_auc)
    history["val_f1"].append(val_f1)

    if val_auc > best_val_auc:
        best_val_auc = val_auc
        no_improve   = 0
        torch.save({
            "epoch":       epoch,
            "model_state": model.state_dict(),
            "val_auc":     val_auc,
            "val_f1":      val_f1,
            "scaler":      scaler,
            "card2idx":    card2idx,
        }, GNN_WEIGHTS)
    else:
        no_improve += 1
        if no_improve >= EARLY_STOP:
            print(f"  Early stop at epoch {epoch} — no improvement for {EARLY_STOP} epochs")
            break

    if epoch % 10 == 0:
        elapsed = time.time() - t0
        print(f"  Epoch {epoch:>3}  loss={total_loss/len(train_loader):.4f}  "
              f"val_auc={val_auc:.4f}  val_f1={val_f1:.4f}  "
              f"[{elapsed:.0f}s elapsed]  [no_improve={no_improve}]")

print(f"\nBest val AUC: {best_val_auc:.4f}  (saved → {GNN_WEIGHTS})")


