# ── Cell 10c: Extract GNN embeddings as LightGBM features ─────────────────────
print("Extracting GNN embeddings …")

class GraphSAGEEmbedder(torch.nn.Module):
    """Same architecture as GraphSAGEFraud but returns embeddings not logits."""
    def __init__(self, in_ch, hidden=256, dropout=0.4):
        super().__init__()
        self.conv1     = SAGEConv(in_ch, hidden)
        self.conv2     = SAGEConv(hidden, hidden * 2)
        self.conv3     = SAGEConv(hidden * 2, hidden)
        self.bn1       = torch.nn.BatchNorm1d(hidden)
        self.bn2       = torch.nn.BatchNorm1d(hidden * 2)
        self.bn3       = torch.nn.BatchNorm1d(hidden)
        self.drop      = torch.nn.Dropout(dropout)
        self.skip_proj = torch.nn.Linear(in_ch, hidden)

    def forward(self, x, edge_index):
        res = self.skip_proj(x)
        x   = self.conv1(x, edge_index); x = self.bn1(x).relu(); x = self.drop(x); x = x + res
        x   = self.conv2(x, edge_index); x = self.bn2(x).relu(); x = self.drop(x)
        x   = self.conv3(x, edge_index); x = self.bn3(x).relu(); x = self.drop(x)
        return x   # return 256-dim embedding, not logit

embedder = GraphSAGEEmbedder(in_ch=data.num_features).to(DEVICE)

# load weights from trained model (conv layers are shared)
state = torch.load(GNN_WEIGHTS, weights_only=False)["model_state"]
# load only the keys that exist in embedder (excludes head layer)
embedder.load_state_dict(
    {k: v for k, v in state.items() if k in embedder.state_dict()},
    strict=False
)
embedder.eval()

# extract embeddings in batches to avoid OOM
from torch_geometric.loader import NeighborLoader
embed_loader = NeighborLoader(
    data, num_neighbors=[15, 10, 5], batch_size=512,
    input_nodes=torch.arange(data.num_nodes), shuffle=False,
)

all_embeddings = torch.zeros(data.num_nodes, 256)
with torch.no_grad():
    for batch in embed_loader:
        batch = batch.to(DEVICE)
        emb   = embedder(batch.x, batch.edge_index)[:batch.batch_size]
        all_embeddings[batch.n_id[:batch.batch_size]] = emb.cpu()

print(f"  Embeddings shape: {all_embeddings.shape}")

# add top-20 PCA components of embeddings to card_feats
from sklearn.decomposition import PCA
pca   = PCA(n_components=20, random_state=SEED)
emb_pca = pca.fit_transform(all_embeddings.numpy())
print(f"  PCA explained variance: {pca.explained_variance_ratio_.sum():.3f}")

emb_cols = [f"gnn_emb_{i}" for i in range(20)]
for i, col in enumerate(emb_cols):
    card_feats[col] = emb_pca[:, i]

# add to NODE_FEATURE_COLS so LightGBM picks them up in Cell 11
for col in emb_cols:
    if col not in NODE_FEATURE_COLS:
        NODE_FEATURE_COLS.append(col)

print(f"  Added {len(emb_cols)} GNN embedding features — total: {len(NODE_FEATURE_COLS)}")


