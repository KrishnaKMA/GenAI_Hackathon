pos_weight   = torch.tensor([clean_count / fraud_count], dtype=torch.float).to(DEVICE)
criterion    = torch.nn.BCEWithLogitsLoss(pos_weight=pos_weight)

print(f"Model params: {sum(p.numel() for p in model.parameters()):,}")
