# Cell 6: Build the graph
print("Building transaction graph …")
 
# Index cards so they map to integer node IDs
card2idx = {c: i for i, c in enumerate(card_feats["card1"])}
 
edges_src, edges_dst, edge_weights = [], [], []
 
def add_edges_from_shared(col: str, max_group_size: int = 50):
    """Connect cards that share the same value — skip huge groups (likely noise)."""
    for val, grp in tqdm(df.groupby(col), desc=f"  edges/{col}", leave=False):
        cards = [c for c in grp["card1"].unique() if c in card2idx]
        if len(cards) > max_group_size:   # skip mega-groups — they're noise not rings
            continue
        for i in range(len(cards)):
            for j in range(i + 1, len(cards)):
                edges_src.append(card2idx[cards[i]])
                edges_dst.append(card2idx[cards[j]])
 
# Three edge types — same logic ClaimShield uses for claimant→provider
add_edges_from_shared("P_emaildomain")
add_edges_from_shared("card2")
add_edges_from_shared("addr1")
 
# Make bidirectional
src = torch.tensor(edges_src + edges_dst, dtype=torch.long)
dst = torch.tensor(edges_dst + edges_src, dtype=torch.long)
edge_index = torch.stack([src, dst], dim=0)
 
