# ClaimShield environment template
# Copy to .env for local use. Render can set these in the dashboard or via render.yaml.

# Security
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
FERNET_KEY=
JWT_SECRET=dev-secret-change-in-production

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=

# IBM
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_SPACE_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
DB2_DSN=

# Database / hosted overrides
DB_BACKEND=auto
SQLITE_PATH=data/local.db
LOCAL_FACTSHEETS_PATH=data/local_factsheets.json
FORCE_MOCK_IBM=false
DB_CONNECT_RETRIES=30
DB_CONNECT_DELAY_SECONDS=10
