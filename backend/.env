# ═══════════════════════════════════════════════════════════
# ClaimShield — Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────
# KRISHNA fills in (generate once):
# ─────────────────────────────────────────────────────────

# JWT RS256 keys (run: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
# Paste the full key content, replacing newlines with \n
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Fernet key for PII encryption (run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Fallback secret for dev when RS256 keys not set
JWT_SECRET=dev-secret-change-in-production

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────
# TEAMMATE B fills in (from IBM Cloud):
# ─────────────────────────────────────────────────────────

# IBM watsonx.ai credentials
WATSONX_API_KEY=claimshield-api
WATSONX_PROJECT_ID=439a6bc9-c05d-4b4b-b627-98b9b92ba0d4
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Db2 connection string
# Get from: IBM Cloud → Db2 → Service Credentials → dsn
DB2_DSN=

# ─────────────────────────────────────────────────────────
# AUTO-DETECTION (do not change):
# - When WATSONX_API_KEY is empty → mock IBM runs
# - When DB2_DSN is empty → SQLite runs at data/local.db
# - When model files missing → mock ML runs
# ─────────────────────────────────────────────────────────

WATSONX_SPACE_ID=   

#  ← watsonx.ai → Deployments → Spaces → your space ID